# Kopieren nach .env.local und mit echten Werten aus dem Supabase-Projekt füllen.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Nur serverseitig verwenden, niemals mit NEXT_PUBLIC_ prefixen!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Affiliate-Links (Phase 1, unkritisch). Bis ein echter Link eingetragen
# ist, blendet die Affiliate-Callout-Komponente sich selbst aus statt
# eines toten/Platzhalter-Links.
AFFILIATE_ENGLISH_COURSE_URL=
